# Environment configuration
NODE_ENV=production

# Server port (Railway/Render will set this automatically)
PORT=3000

# CORS - comma-separated list of allowed origins for production
# NEVER use * in production — list your actual origins
# Example: https://yourgame.com,https://www.yourgame.com
ALLOWED_ORIGINS=

# Admin key for protected endpoints — use a strong random secret (32+ chars)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_RESET_KEY=

# Game client API key — shared secret between game and server
# Leave empty to disable (allow all clients). Set to activate enforcement.
# The game client must send this in the x-api-key header.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
GAME_API_KEY=

# Optional: Anthropic API key for AI crash analysis
ANTHROPIC_API_KEY=

# Optional: Azure AI Content Safety — moderates uploaded design thumbnails.
# Create a "Content Safety" resource in the Azure portal (F0 free tier =
# 5,000 images/month, no overage). Leave empty to skip moderation entirely.
# Endpoint looks like: https://<resource-name>.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# Reject threshold for image severity (Azure reports 0/2/4/6 per category;
# 2 = block anything not fully clean). Default: 2
MODERATION_SEVERITY_THRESHOLD=2

# Each thumbnail is moderated as the full frame PLUS this tile grid — small
# explicit details (custom images in art frames) score 0 at full-frame scale
# but max severity when tiled. '0' disables tiling (full frame only).
# Default: 2x2 (= 5 API calls per thumbnail)
MODERATION_TILE_GRID=2x2

# Delay between moderation calls in ms. The F0 free tier allows ~1 req/s;
# on the paid S0 tier this can be lowered to 0. Default: 1100
MODERATION_CALL_DELAY_MS=1100

# Set to 1 to reject thumbnail uploads when the moderation service is
# unreachable/unconfigured (default: uploads are allowed through)
MODERATION_FAIL_CLOSED=